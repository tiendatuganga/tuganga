# Shopify Storefront API (Headless)
# Cuando estén definidas, la app puede empezar a usar lib/shopify/* para
# implementar ShopifyProductService / ShopifyCategoryService.
# Hasta entonces, la web funciona con los servicios Mock (data/mock).
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=tu_token_storefront

# WhatsApp de ventas (solo dígitos, con prefijo internacional, sin '+' ni espacios)
# Ejemplo España: 34600123456
NEXT_PUBLIC_WHATSAPP_NUMBER=34614826697
