# Shopify Storefront API (Headless)
# Cuando estén definidas, la app puede empezar a usar lib/shopify/* para
# implementar ShopifyProductService / ShopifyCategoryService / ShopifyCartService.
# Hasta entonces, la web funciona con los servicios Mock (data/mock).
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=tu-storefront-access-token
